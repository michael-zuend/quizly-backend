# Copy this file to .env and replace all placeholder values.
# .env is listed in .gitignore and .dockerignore and is never committed.

# Django secret key, at least 50 random characters. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-string
# True only for local development. False activates HTTPS, HSTS, secure
# cookies and the rate limits.
DEBUG=True
# Host names the backend answers to.
ALLOWED_HOSTS=127.0.0.1,localhost
# Origins of the frontend that may send requests with cookies.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Gemini model that creates the quiz.
GEMINI_MODEL=gemini-2.5-flash
# Whisper model size: tiny, base, small, medium or large.
WHISPER_MODEL=base

# Limits against abuse.
# Maximum video length in seconds.
MAX_VIDEO_DURATION=1800
# Maximum audio file size in bytes (100 MB).
MAX_AUDIO_FILESIZE=104857600
# Maximum number of transcript characters sent to Gemini.
MAX_TRANSCRIPT_CHARS=30000

# Log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# PostgreSQL, used by docker compose. Without POSTGRES_HOST the backend
# uses SQLite (local development).
POSTGRES_DB=quizly
POSTGRES_USER=quizly
POSTGRES_PASSWORD=replace-with-a-strong-password
